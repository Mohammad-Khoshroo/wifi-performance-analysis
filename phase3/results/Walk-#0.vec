version 3
run Walk-0-20261125-14:08:41-627
attr configname Walk
attr datetime 20261125-14:08:41
attr datetimef 20261125-140841
attr experiment Walk
attr inifile omnetpp.ini
attr iterationvars ""
attr iterationvarsd ""
attr iterationvarsf ""
attr measurement ""
attr network Roaming
attr processid 627
attr repetition 0
attr replication #0
attr resultdir results
attr runnumber 0
attr seedset 0
config cmdenv-redirect-output true
config image-path /home/medanaee/omnet/inet-4.7.0/images
config description "the station walks from ap1 to ap2; INET's own roaming decision"
config repeat 5
config *.ap*.sink.packets.result-recording-modes +vector(packetLength)
config *.ap*.sink.packets:vector(packetLength).vector-recording true
config *.host.wlan.agent.*:vector.vector-recording true
config *.host.wlan.radio.radioChannel:vector.vector-recording true
config *.host.wlan.radio.minSnir.result-recording-modes +vector
config *.host.wlan.radio.minSnir:vector.vector-recording true
config *.host.wlan.mac.dcf.packetSentToPeerWith*Retry:vector(packetBytes).vector-recording true
config network Roaming
config Contention.**.wlan*.bitrate 12Mbps
config Contention.**.cli.reqLength 650B
config Anomaly.n 5
config Anomaly.host[0].wlan[*].bitrate 9Mbps
config Anomaly.host[*].wlan[*].bitrate 48Mbps
config Anomaly.ap.wlan[*].bitrate 48Mbps
config Anomaly.**.messageLength 650B
config Anomaly.ap.**.pendingQueue.numQueues 5
config Roaming.D 87m
config Roaming.radioMedium.pathLoss.alpha 2.8
config Roaming.radioMedium.pathLoss.sigma 5
config Roaming.ap*.wlan.mgmt.beaconInterval 100ms
config Roaming.host.wlan.mgmt.numChannels 8
config Roaming.*.mobility.turtleScript "xml(\"<movement><set x='50' y='102' speed='1.25' angle='0'/><forward d='87'/></movement>\")"
config sim-time-limit 120s
config **.vector-recording false
config **.constraintAreaMinX 0m
config **.constraintAreaMinY 0m
config **.constraintAreaMinZ 0m
config **.constraintAreaMaxX 600m
config **.constraintAreaMaxY 200m
config **.constraintAreaMaxZ 0m
config **.mobility.initialZ 0m
config **.mobility.initFromDisplayString false
config *.radioMedium.pathLoss.typename LogNormalShadowing
config *.radioMedium.sameTransmissionStartTimeCheck "\"ignore\""
config *.radioMedium.analogModel.ignorePartialInterference true
config **.opMode "\"a\""
config **.radio.bandName "\"5 GHz (20 MHz)\""
config **.radio.transmitter.power 20mW
config **.wlan*.bitrate 12Mbps
config **.rateSelection.mgmtFrameBitrate 6Mbps
config **.rateSelection.multicastFrameBitrate 6Mbps
config *.ap1.wlan.address "\"10:00:00:00:00:01\""
config *.ap2.wlan.address "\"10:00:00:00:00:02\""
config *.ap*.wlan.mgmt.ssid "\"CA2\""
config *.ap1.wlan.radio.channelNumber 1
config *.ap2.wlan.radio.channelNumber 3
config *.host.cli.destAddress "\"20:00:00:00:00:00\""
config *.host.cli.sendInterval 20ms
config *.host.cli.reqLength 160B
config *.host.cli.respLength 0B
config *.host.cli.startTime 1s

